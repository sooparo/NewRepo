<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="문자 · 카카오톡 · 네이버 웍스 메시지에서 일정을 찾으면 알림으로 물어봅니다:\n[📅 캘린더] [⏰ 알람] [둘 다]"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenTasks"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="✅ 할 일 · 🕘 저장 기록 보기" />

        <!-- 1. 권한 -->
        <TextView
            style="@style/SectionTitle"
            android:text="1. 권한" />

        <TextView android:id="@+id/statusListener" style="@style/StatusText" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListenerAccess"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알림 접근 허용하기" />
        <TextView
            android:id="@+id/restrictedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 '제한된 설정'이라며 켜지지 않으면: 앱 정보 → 오른쪽 위 ⋮ → '제한된 설정 허용' 후 다시 시도하세요. (Play 스토어 외 설치 앱의 안드로이드 보안 정책)"
            android:textAppearance="?attr/textAppearanceBodySmall" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppInfo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 정보 열기" />

        <TextView android:id="@+id/statusPostNotifications" style="@style/StatusText" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPostNotifications"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알림 표시 허용" />

        <TextView android:id="@+id/statusExactAlarm" style="@style/StatusText" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExactAlarm"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알람 권한 허용" />

        <TextView android:id="@+id/statusFullScreen" style="@style/StatusText" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullScreen"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체 화면 알림 허용" />

        <!-- 2. 네이버 캘린더 -->
        <TextView
            style="@style/SectionTitle"
            android:text="2. 네이버 캘린더 연결 (CalDAV)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="네이버 → 내정보 → 보안설정 → 2단계 인증 → '애플리케이션 비밀번호 관리'에서 발급한 비밀번호를 입력하세요. (네이버 로그인 비밀번호 아님)"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="네이버 아이디">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNaverId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="애플리케이션 비밀번호">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNaverPw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="연결하고 캘린더 선택" />

        <TextView android:id="@+id/calendarStatus" style="@style/StatusText" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCalendarReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="캘린더 일정에도 알림 넣기" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchIncludeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메시지 원문을 일정 메모에 포함 (환자정보 등 주의)" />

        <!-- 3. 알람 -->
        <TextView
            style="@style/SectionTitle"
            android:text="3. 알람" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기본 알람 시점" />

            <Spinner
                android:id="@+id/spinnerLead"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchClockApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기본 시계 앱에 알람 등록 (24시간 이내 일정만, 그 외엔 앱 알람)" />

        <!-- 4. 감지 대상 앱 -->
        <TextView
            style="@style/SectionTitle"
            android:text="4. 감지할 앱" />

        <TextView
            android:id="@+id/packagesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPackages"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 선택" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="목록에 없는 앱은, 그 앱에서 메시지 알림을 한 번 받은 뒤 여기서 선택할 수 있어요."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- 5. 위젯 · 아침 브리핑 · 알림 버튼 -->
        <TextView
            style="@style/SectionTitle"
            android:text="5. 위젯 · 아침 브리핑" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="홈 화면 빈 곳을 길게 누르기 → 위젯 → '일정캐치'를 추가하면 일정과 할 일이 보입니다. 위젯에서 할 일을 누르면 완료 체크됩니다."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchBriefing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="아침 브리핑 알림 (오늘 일정 · 할 일 요약)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBriefingTime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBriefingNow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="지금 미리보기" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchThirdBoth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="감지 알림 세 번째 버튼을 [할 일] 대신 [둘 다(캘린더+알람)]로" />

        <!-- 6. 대화방을 보고 있을 때 -->
        <TextView
            style="@style/SectionTitle"
            android:text="6. 대화방을 보고 있을 때" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="카톡 대화방을 열어두면 알림이 뜨지 않아 자동 감지가 안 됩니다. 아래 두 방법을 쓸 수 있어요."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📋 붙여넣기: 메시지를 길게 눌러 '복사' → 알림창을 내려 '일정 붙여넣기' 타일, 또는 위젯의 📋, 또는 앱 아이콘 길게 누르기 → '일정 붙여넣기'.\n(타일 추가: 알림창 두 번 내리기 → 연필(편집) → '일정 붙여넣기'를 끌어다 놓기)"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaste"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 지금 복사한 메시지로 일정 만들기" />

        <TextView
            android:id="@+id/statusScreenReader"
            style="@style/StatusText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👀 화면 읽기(선택): 대화방을 보고 있을 때도 새 메시지를 자동 감지합니다. '감지할 앱'의 화면만 받고, 저장하지 않으며, 아래 개인정보 가리기가 먼저 적용됩니다. 병원 보안 규정에서 접근성 앱 사용이 허용되는지 확인 후 켜세요."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScreenReader"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="접근성 설정 열기 → 설치된 앱 → 일정캐치 화면 읽기" />

        <!-- 7. 개인정보 가리기 -->
        <TextView
            style="@style/SectionTitle"
            android:text="7. 개인정보 가리기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="알림 · 화면 읽기 · 붙여넣기 · 공유 모두, 분석하기 전에 아래 정보를 지웁니다."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMaskReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="등록번호 8자리 → ********" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMaskPersonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="주민번호 · 전화번호" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMaskNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="호칭 붙은 이름 (홍길동 환자 → OOO 환자)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHideSender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="보낸 사람 이름 저장 안 함 (앱 이름만)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 호칭 없이 쓴 이름(예: '길동이 CT')은 이름인지 판단할 수 없어 가려지지 않습니다."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- 8. 인식 테스트 -->
        <TextView
            style="@style/SectionTitle"
            android:text="8. 인식 테스트" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예) 내일 오후 3시 회의실에서 QA 회의 있습니다">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="분석" />

        <TextView android:id="@+id/testResult" style="@style/StatusText" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestOpen"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="확인 화면 열기" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestNotify"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="감지 알림 띄워보기" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
